# =============================================================================
# CRM Prospectación ZMG — .gitignore
# =============================================================================

# --- Backend (Python) ---
backend/venv/
backend/.venv/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Variables de entorno y secretos (NUNCA subir esto a GitHub)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local

# Alembic (los archivos de versiones SÍ se suben; esto es solo cache local si existiera)
backend/alembic/__pycache__/

# --- Frontend (Node / Vite) ---
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/.vite/
*.local

# Logs de npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Playwright ---
# Los navegadores descargados por Playwright viven fuera del repo
# (AppData\Local\ms-playwright en Windows), no hace falta ignorarlos aquí,
# pero por si acaso se generan localmente:
backend/.playwright/
test-results/
playwright-report/
playwright/.cache/

# --- Bases de datos locales / dumps ---
*.sqlite3
*.db
*.sql.gz
db/*.dump

# --- Editores / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Archivos temporales propios del proyecto ---
*.log
/tmp/
